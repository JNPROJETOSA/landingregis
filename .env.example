# ── Copie para .env.local e preencha. Segredos de backend NUNCA são versionados.

# Base do site (para links absolutos / Open Graph)
NEXT_PUBLIC_SITE_URL=https://mentoria-regisdencia.com.br

# WhatsApp (somente dígitos, com DDI + DDD). O front-end anexa ?ref/?cupom quando disponíveis.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Google Forms / Google Sheets via Google Apps Script (SOMENTE no backend)
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# Supabase — cliente (URL + anon key podem ser expostas ao navegador; a service role NUNCA pode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — servidor (service role; SOMENTE no backend)
SUPABASE_SERVICE_ROLE_KEY=

# Prazo de resposta exibido no sucesso do formulário (apenas se confirmado/configurado)
CONTACT_SLA_ENABLED=false

# Telegram (backend)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail transacional (backend) — ex.: Resend, Postmark, SES
MAIL_PROVIDER=
MAIL_TOKEN=
MAIL_FROM=equipe@mentoria-regisdencia.com.br
MAIL_TO=equipe@mentoria-regisdencia.com.br

# Painel administrativo protegido
ADMIN_APP_URL=
# Senha do painel (somente backend; o painel autentica por ela)
ADMIN_PASSWORD=
